<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FoodWasteAPP.ReminderPage"
    Title="Reminders">

    <ScrollView>

        <VerticalStackLayout
            Padding="24"
            Spacing="15">

            <Label
                Text="Reminders"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#222222" />

            <Label
                Text="Your food reminders will appear here."
                FontSize="18"
                TextColor="#666666" />

<VerticalStackLayout
    x:Name="ReminderList"
    Spacing="10" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>