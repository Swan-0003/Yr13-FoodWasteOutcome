<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FoodWasteAPP.ReminderPage"
    Title="Reminders">

    <ScrollView>

        <VerticalStackLayout
            Padding="24"
            Spacing="15">

            <Label
                Text="Reminders"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#222222" />

            <Label
                Text="Your food reminders will appear here."
                FontSize="18"
                TextColor="#666666" />

                <Grid
    ColumnDefinitions="*,*"
    ColumnSpacing="12">

    <Button
        x:Name="ReminderListButton"
        Grid.Column="0"
        Text="List"
        FontSize="18"
        Clicked="OnReminderListClicked" />

    <Button
        x:Name="ReminderCalendarButton"
        Grid.Column="1"
        Text="Calendar"
        FontSize="18"
        Clicked="OnReminderCalendarClicked" />

</Grid>

<VerticalStackLayout
    x:Name="ReminderList"
    Spacing="10" />

    <VerticalStackLayout
    x:Name="ReminderCalendarView"
    Spacing="12"
    IsVisible="False">

    <Label
        x:Name="CalendarMonthLabel"
        Text="Calendar"
        FontSize="22"
        FontAttributes="Bold"
        HorizontalOptions="Center" />

    <Grid
        x:Name="CalendarGrid"
        ColumnDefinitions="*,*,*,*,*,*,*"
        ColumnSpacing="5"
        RowSpacing="5" />

</VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>