<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodWasteAPP.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="16">
<Label
    Text="Good morning, User"
    FontSize="26"
    FontAttributes="Bold"
    TextColor="#222222" />

<Label
    Text="Dashboard"
    FontSize="20"
    TextColor="#555555" />

    <Border
    BackgroundColor="#EAF4E8"
    Stroke="#D0D0D0"
    StrokeThickness="1"
    Padding="20">

    <Border.StrokeShape>
        <RoundRectangle CornerRadius="20" />
    </Border.StrokeShape>

    <VerticalStackLayout Spacing="6">

        <Label
            Text="Food saved this month"
            FontSize="18"
            TextColor="#555555" />

        <Label
            Text="0 items"
            FontSize="30"
            FontAttributes="Bold"
            TextColor="#222222" />

        <Label
            Text="Keep going!"
            FontSize="16"
            TextColor="#666666" />

<Label
    Text="Quick Actions"
    FontSize="20"
    FontAttributes="Bold"
    TextColor="#222222"
    Margin="0,10,0,0" />

<Grid
    ColumnDefinitions="*,*"
    ColumnSpacing="12">

    <Button
        Grid.Column="0"
        Text="+ Add Food"
        FontSize="18"
        HeightRequest="60"
        CornerRadius="15"
        BackgroundColor="#EAF4EA"
        TextColor="#222222" />

    <Button
        Grid.Column="1"
        Text="+ Shopping Item"
        FontSize="18"
        HeightRequest="60"
        CornerRadius="15"
        BackgroundColor="#EAF4EA"
        TextColor="#222222" />

</Grid>
    </VerticalStackLayout>

</Border>
        </VerticalStackLayout>
        
    </ScrollView>

</ContentPage>