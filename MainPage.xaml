<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FoodWasteAPP.MainPage"
    BackgroundColor="#F7F9F6">

    <ScrollView>

        <VerticalStackLayout
            Padding="24"
            Spacing="18">

            <!-- Top menu and profile -->
            <Grid
                ColumnDefinitions="Auto,*,Auto"
                VerticalOptions="Center">

                <Button
                    Grid.Column="0"
                    Text="☰"
                    FontSize="28"
                    BackgroundColor="Transparent"
                    TextColor="#26352F"
                    WidthRequest="55"
                    HeightRequest="55"
                    Clicked="OnMenuClicked" />

                <Button
                    x:Name="ProfileButton"
                    Grid.Column="2"
                    Text="●"
                    FontSize="28"
                    BackgroundColor="#E6F1E9"
                    TextColor="#2F7D5B"
                    CornerRadius="28"
                    WidthRequest="56"
                    HeightRequest="56"
                    Padding="4"
                    Clicked="OnProfileClicked" />

            </Grid>

            <!-- Greeting -->
           <HorizontalStackLayout
    Spacing="10"
    VerticalOptions="Center">

    <Image
        Source="sun.png"
        WidthRequest="30"
        HeightRequest="30"
        Aspect="AspectFit"
        VerticalOptions="Center" />

    <Label
        x:Name="GreetingLabel"
        Text="Good morning, User"
        FontSize="28"
        FontAttributes="Bold"
        TextColor="#26352F"
        VerticalOptions="Center" />

</HorizontalStackLayout>

<Label
    Text="Dashboard"
    FontSize="20"
    TextColor="#66726C" />


            <!-- Inventory summary card -->
            <Border
                BackgroundColor="#E6F1E9"
                Stroke="#C7D9CD"
                StrokeThickness="1"
                Padding="22">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Food in your Inventory"
                        FontSize="18"
                        TextColor="#516159" />

                    <Label
                        x:Name="InventoryCountLabel"
                        Text="0 items"
                        FontSize="32"
                        FontAttributes="Bold"
                        TextColor="#26352F" />

                    <Label
                        Text="Use your food before it expires!"
                        FontSize="16"
                        TextColor="#66726C" />

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="#C7D9CD"
                        Margin="0,8,0,4" />

                    <Label
                        Text="Quick Actions"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#26352F" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">

                        <Button
                            Grid.Column="0"
                            Text="+ Add Food"
                            FontSize="17"
                            HeightRequest="55"
                            CornerRadius="16"
                            BackgroundColor="#FFFFFF"
                            TextColor="#2F7D5B"
                            Clicked="OnAddFoodClicked" />

                        <Button
                            Grid.Column="1"
                            Text="+ Shopping Item"
                            FontSize="17"
                            HeightRequest="55"
                            CornerRadius="16"
                            BackgroundColor="#FFFFFF"
                            TextColor="#2F7D5B"
                            Clicked="OnShoppingItemClicked" />

                    </Grid>

                </VerticalStackLayout>

            </Border>


            <!-- Upcoming expiry -->
            <Border
                BackgroundColor="#FFFFFF"
                Stroke="#D8DFDA"
                StrokeThickness="1"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="Upcoming expiry"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="#26352F" />

                    <Label
                        x:Name="UpcomingExpiryLabel"
                        Text="No food expiring soon"
                        FontSize="17"
                        TextColor="#66726C"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>

            </Border>


            <!-- Small motivation section -->
            <Border
                BackgroundColor="#F0F5F1"
                Stroke="#D8DFDA"
                StrokeThickness="1"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="Small actions make a difference"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#26352F" />

                    <Label
                        Text="Check your inventory before shopping and use food that expires soon first."
                        FontSize="16"
                        TextColor="#66726C"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>