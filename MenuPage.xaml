<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FoodWasteAPP.MenuPage"
    Title="Menu">

    <VerticalStackLayout
        Padding="24"
        Spacing="15">

        <Label
            Text="Menu"
            FontSize="28"
            FontAttributes="Bold" />

        <Button
            Text="Achievements"
            FontSize="18"
            Clicked="OnAchievementsClicked" />

        <Button
            Text="Settings"
            FontSize="18"
            Clicked="OnSettingsClicked" />

        <Button
            Text="About"
            FontSize="18"
            Clicked="OnAboutClicked" />

    </VerticalStackLayout>

</ContentPage>