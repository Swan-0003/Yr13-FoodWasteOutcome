<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FoodWasteAPP.ShoppingPage"
    Title="Shopping">

    <VerticalStackLayout Padding="24" Spacing="15">

        <Label
            Text="Shopping List"
            FontSize="26"
            FontAttributes="Bold"
            TextColor="#222222" />

        <Label
            Text="Your shopping list will appear here."
            FontSize="16"
            TextColor="#666666" />

            <Entry
    x:Name="ShoppingItemEntry"
    Placeholder="Enter shopping item"
    FontSize="16" />

<Button
    Text="+ Add Item"
    Clicked="OnAddItemClicked" />

<VerticalStackLayout
    x:Name="ShoppingList"
    Spacing="10" />

    </VerticalStackLayout>

</ContentPage>