<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FoodWasteAPP.InventoryPage"
    Title="Inventory">

<ScrollView>

<VerticalStackLayout Padding="24" Spacing="15">

  <Label
    Text="Inventory"
    FontSize="26"
    FontAttributes="Bold"
    TextColor="#222222"/>

    <Label
      Text="Your inventory will appear here."
      FontSize="18"
      TextColor="#666666"/>

      <Entry
        x:Name="InventoryItemEntry"
        Placeholder="Enter food item"
        FontSize="18" />

        <Entry
          x:Name="InventoryCategoryEntry"
          Placeholder="Enter food category"
          FontSize="18" />

          <DatePicker
            x:Name="ExpiryDatePicker"
            FontSize="18" />

<Button
    Text="+ Add food"
    Clicked="OnAddItemClicked" />

    <VerticalStackLayout
        x:Name="InventoryList"
        Spacing="10" />


</VerticalStackLayout>

</ScrollView>

</ContentPage>