<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FoodWasteAPP.InventoryPage"
    Title="Inventory"
    BackgroundColor="#F7F9F6">

    <ScrollView>

        <VerticalStackLayout
            Padding="24"
            Spacing="18">

            <!-- Page title -->
            <Label
                Text="Inventory"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#26352F" />

            <Label
                Text="Keep track of the food you already have."
                FontSize="17"
                TextColor="#66726C" />


            <!-- List / Grid buttons -->
            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="12">

                <Button
                    x:Name="ListViewButton"
                    Grid.Column="0"
                    Text="List"
                    FontSize="18"
                    HeightRequest="50"
                    CornerRadius="18"
                    BackgroundColor="#A9CBAE"
                    TextColor="#26352F"
                    Clicked="OnListViewClicked" />

                <Button
                    x:Name="GridViewButton"
                    Grid.Column="1"
                    Text="Grid"
                    FontSize="18"
                    HeightRequest="50"
                    CornerRadius="18"
                    BackgroundColor="#E2EBE3"
                    TextColor="#26352F"
                    Clicked="OnGridViewClicked" />

            </Grid>


            <!-- Add food section -->
            <Border
                BackgroundColor="#FFFFFF"
                Stroke="#D8DFDA"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Add food"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#26352F" />

                    <Entry
                        x:Name="InventoryItemEntry"
                        Placeholder="Enter food item"
                        FontSize="18"
                        BackgroundColor="#F5F7F5"
                        TextColor="#26352F" />

                    <Entry
                        x:Name="InventoryCategoryEntry"
                        Placeholder="Enter food category"
                        FontSize="18"
                        BackgroundColor="#F5F7F5"
                        TextColor="#26352F" />

                    <Label
                        Text="Expiry date"
                        FontSize="16"
                        TextColor="#66726C" />

                    <DatePicker
                        x:Name="ExpiryDatePicker"
                        FontSize="18"
                        BackgroundColor="#F5F7F5"
                        TextColor="#26352F" />

                    <Button
                        Text="+ Add food"
                        FontSize="18"
                        HeightRequest="52"
                        CornerRadius="16"
                        BackgroundColor="#A9CBAE"
                        TextColor="#26352F"
                        Clicked="OnAddItemClicked" />

                </VerticalStackLayout>

            </Border>


            <!-- Inventory heading -->
            <Label
                Text="Your food"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#26352F" />

<Button
    x:Name="UndoDeleteButton"
    Text="↶ Undo last delete"
    FontSize="16"
    HeightRequest="45"
    CornerRadius="15"
    BackgroundColor="#E2EBE3"
    TextColor="#26352F"
    IsVisible="False"
    Clicked="OnUndoDeleteClicked" />

            <!-- List view -->
            <VerticalStackLayout
                x:Name="InventoryList"
                Spacing="10" />


            <!-- Grid view -->
            <Grid
                x:Name="InventoryGrid"
                ColumnDefinitions="*,*"
                ColumnSpacing="10"
                RowSpacing="10"
                IsVisible="False" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>