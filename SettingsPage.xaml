<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FoodWasteAPP.SettingsPage"
    Title="Settings"
    BackgroundColor="#F7F9F6">

    <ScrollView>

        <VerticalStackLayout
            Padding="24"
            Spacing="18">

            <Label
                Text="Settings"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#26352F" />

            <Label
                Text="Customise your profile."
                FontSize="17"
                TextColor="#66726C" />

            <!-- Profile section -->
            <Border
                BackgroundColor="#FFFFFF"
                Stroke="#D8DFDA"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Profile"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#26352F" />

                    <Label
                        Text="Choose profile icon"
                        FontSize="17"
                        TextColor="#66726C" />

                    <HorizontalStackLayout
                        Spacing="12"
                        HorizontalOptions="Center">

                        <Button
                            Text="🌱"
                            FontSize="28"
                            WidthRequest="65"
                            HeightRequest="65"
                            CornerRadius="18"
                            BackgroundColor="#E6F1E9"
                            Clicked="OnProfileOneClicked" />

                        <Button
                            Text="🍎"
                            FontSize="28"
                            WidthRequest="65"
                            HeightRequest="65"
                            CornerRadius="18"
                            BackgroundColor="#E6F1E9"
                            Clicked="OnProfileTwoClicked" />

                        <Button
                            Text="🌿"
                            FontSize="28"
                            WidthRequest="65"
                            HeightRequest="65"
                            CornerRadius="18"
                            BackgroundColor="#E6F1E9"
                            Clicked="OnProfileThreeClicked" />

                    </HorizontalStackLayout>

                    <Label
                        x:Name="SelectedProfileLabel"
                        Text="No profile icon selected"
                        FontSize="16"
                        TextColor="#66726C"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Name"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="#26352F" />

                    <Entry
                        x:Name="NameEntry"
                        Placeholder="Enter your name"
                        FontSize="18"
                        BackgroundColor="#F5F7F5"
                        TextColor="#26352F" />

                    <Button
                        Text="Save profile"
                        FontSize="18"
                        HeightRequest="52"
                        CornerRadius="16"
                        BackgroundColor="#A9CBAE"
                        TextColor="#26352F"
                        Clicked="OnSaveProfileClicked" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>